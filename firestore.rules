rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 신분은 서버 로그인 토큰(memberLogin/adminLogin)의 claims 로 판단.
    // 손님은 익명 토큰(claims 없음), 승인 대기는 {p:1}, 승인 회원은 {m:1}, 관리자는 {admin:1}.
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == 1; }
    function isMember() { return signedIn() && request.auth.token.m == 1; }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }

    // 앱 상태(회원·요청·메시지 등) — 승인 회원·관리자만.
    // 회원은 회원 기능이 쓰는 항목만 바꿀 수 있음. 관리자 키(adminAuth)·공지·팝업·주간 인사·관리자 설정·
    // 문자 기록·삭제 이력·PIN 재설정 요청 등은 관리자만 (예: 회원이 관리자 공개키를 바꿔치기해 새 가입자 실명·번호를 가로채는 것 차단).
    // 손님·승인 대기의 쓰기는 서버 함수(applicantAction)가 대행
    function memberStateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'entries', 'pendingEntries', 'dateRequests', 'messages', 'logs', 'joinRequests',
        'connLog', 'connEver', 'coupleReports', 'appVersion', 'dm'
      ]);
    }
    match /app/state {
      allow read: if isMember() || isAdmin();
      allow update: if isAdmin() || (isMember() && memberStateKeysOnly());
      allow create, delete: if isAdmin();
    }

    // 활동 기록 아카이브 — 승인 회원·관리자만
    match /app/logs {
      allow read, write: if isMember() || isAdmin();
    }

    // 공개 요약(손님 화면용: 인원·티저·로그인 목록) — 서버(onStateChange)만 씀
    match /app/public {
      allow read: if true;
      allow write: if false;
    }

    // 사진 원본 — 서버(onStateChange.syncPhotoAcl)가 붙인 viewers 만 읽기 (서로 사진 승인·사진 공개·본인·주선자), 관리자 전체.
    // 고치기는 owners(본인·주선자)·관리자, 바꿀 수 있는 건 photos 뿐(열람 목록은 서버만)
    match /photos/{entryId} {
      allow read: if isAdmin() || isSelf(entryId)
                  || (signedIn() && request.auth.uid in resource.data.get('viewers', []));
      allow create: if isAdmin()
                    || ((isMember() || isSelf(entryId)) && request.resource.data.keys().hasOnly(['photos']));
      allow update: if isAdmin()
                    || ((isSelf(entryId) || (signedIn() && request.auth.uid in resource.data.get('owners', [])))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos']));
      allow delete: if isAdmin() || isSelf(entryId)
                    || (signedIn() && request.auth.uid in resource.data.get('owners', []));
    }

    // 푸시 토큰 — 본인 것만, 관리자는 전체(알림 설정 확인용)
    match /pushTokens/{entryId} {
      allow read, write: if isAdmin() || isSelf(entryId);
    }

    // 관리자 전용: 회원별 실명·번호·알게 된 경로(관리자 키로 암호화된 값) — 관리자만
    match /adminOnly/{entryId} {
      allow read, write: if isAdmin();
    }

    // 관리자 개인키(관리자 비밀번호로 감싼 값) — 관리자만
    match /adminKey/{docId} {
      allow read, write: if isAdmin();
    }

    // 대화방(두 사람당 1개) — 대화 당사자(+각자의 주선자)만 읽기, 관리자는 신고된 방만.
    // 보내기·지우기·신고는 서버 함수(chatAction)만
    match /chats/{pair} {
      allow read: if signedIn() && (request.auth.uid in resource.data.viewers
                                    || (isAdmin() && resource.data.reportedAt != null));
      allow write: if false;
    }

    // 그 외 전부 차단 (secrets(PIN 해시)·loginGuard·rateLimit·sendContacts 등은 서버 전용)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
