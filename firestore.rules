rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 신분은 서버 로그인 토큰(memberLogin/adminLogin)의 claims 로 판단.
    // 손님은 익명 토큰(claims 없음), 승인 대기는 {p:1}, 승인 회원은 {m:1}, 관리자는 {admin:1}.
    function notRevoked() { return !(request.auth.uid in ['9cc9116d-7bc6-481c-a280-81c6ef2a82ff','24d69624-2988-45e1-911e-ce9df19c0613','a061a706-0554-449c-bec8-6bd699e5b7dc','161e4ad5-1eee-412a-a762-8d7511240980'] && request.auth.token.auth_time < 1793003100); } // auth_time(처음 로그인 시각) 기준 — iat 는 1시간마다 새로 받으면 바뀌어 차단이 풀림
    function signedIn() { return request.auth != null && notRevoked(); }
    // '이번만 허용' 관리자(10-29): 토큰 ao = 끝 시각(ms), 지나면 관리자 아님 (서버 claimsOf 와 같음)
    function isAdmin() { return signedIn() && request.auth.token.admin == 1 && (request.auth.token.get('ao', 0) == 0 || request.time.toMillis() < request.auth.token.ao); }
    // 이번만이 아닌 관리자 — 관리자 비밀번호·키 바꾸기처럼 12시간 뒤에도 남는 일은 이것만 (이번만 기기가 비번을 바꿔 베니를 잠그지 못하게)
    function isFullAdmin() { return isAdmin() && request.auth.token.get('ao', 0) == 0; }
    function isMember() { return signedIn() && request.auth.token.m == 1; }
    // 관리자 계정 uid('admin')는 본인 규칙에서 뺌 — 이번만 토큰이 끝난 뒤에도 'admin' 본인으로 남의 문서를 쓰지 못하게
    function isSelf(id) { return signedIn() && id != 'admin' && request.auth.uid == id; }

    // 앱 상태(회원·요청·메시지 등) — 승인 회원·관리자만.
    // 회원은 회원 기능이 쓰는 항목만 바꿀 수 있음. 관리자 키(adminAuth)·공지·팝업·주간 인사·관리자 설정·
    // 문자 기록·삭제 이력·PIN 재설정 요청 등은 관리자만 (예: 회원이 관리자 공개키를 바꿔치기해 새 가입자 실명·번호를 가로채는 것 차단).
    // 손님·승인 대기의 쓰기는 서버 함수(applicantAction)가 대행
    function memberStateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        // 'dateRequests' 는 2026-10-29 뺌: 회원 사진·대화 신청은 서버(chatAction req…)만 — 직접 쓰면 차단·하루 한도·휴면 검사를 건너뛰었음
        'entries', 'pendingEntries', 'messages', 'logs', 'joinRequests',
        'connLog', 'connEver', 'coupleReports', 'appVersion', 'dm', '_w', '_wn'
      ]);
    }
    // 쓰기 서명: 모든 앱 쓰기는 쓴 사람(_w = 내 토큰 uid)과 새 난수(_wn)를 붙여야 함 → 서버가 '누가 무엇을 바꿨는지' 감시
    function signedWrite() {
      return request.resource.data.get('_w', '') == request.auth.uid
          && request.resource.data.get('_wn', '') != resource.data.get('_wn', '');
    }
    // 반복 조작으로 자동 차단된 계정(state.secBlock — 서버·관리자만 씀, 회원 쓰기 허용 키에 없음) → 앱 데이터 읽기·쓰기 거부 (2026-10-28)
    function notSecBlocked(st) { return !(request.auth.uid in st.get('secBlock', [])); }
    function stateNotSecBlocked() { return notSecBlocked(get(/databases/$(database)/documents/app/state).data); }
    match /app/state {
      allow read: if isAdmin() || (isMember() && notSecBlocked(resource.data));
      allow update: if signedWrite() && ((isAdmin() && (isFullAdmin() || adminAuthUntouched()))
                                        || (isMember() && notSecBlocked(resource.data) && memberStateKeysOnly()));
      allow create, delete: if isFullAdmin();
    }
    function adminAuthUntouched() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminAuth']); }

    // 보안 경고(서버가 기록) — 관리자만 읽고 '확인함·되돌림' 표시만 바꿈
    match /securityAlerts/{alertId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'restoredAt']);
    }

    // 활동 기록 아카이브 — 승인 회원·관리자만
    match /app/logs {
      allow read, write: if isAdmin() || (isMember() && stateNotSecBlocked());
    }

    // 명단용 작은 사진(썸네일) — 승인 회원·관리자만 읽기, 서버(onStateChange.sweepThumbs)만 씀 (2026-10-14 메인 문서에서 분리)
    match /app/thumbs {
      allow read: if isAdmin() || (isMember() && stateNotSecBlocked());
      allow write: if false;
    }

    // 공개 요약(손님 화면용: 인원·티저·로그인 목록) — 서버(onStateChange)만 씀
    match /app/public {
      allow read: if true;
      allow write: if false;
    }

    // 사진 원본 — 서버(onStateChange.syncPhotoAcl)가 붙인 viewers 만 읽기 (서로 사진 승인·사진 공개·본인·주선자), 관리자 전체.
    // 고치기는 owners(본인·주선자)·관리자, 바꿀 수 있는 건 photos 뿐(열람 목록은 서버만)
    match /photos/{entryId} {
      allow read: if isAdmin() || isSelf(entryId)
                  || (signedIn() && request.auth.uid in resource.data.get('viewers', []));
      allow create: if isAdmin()
                    || ((isMember() || isSelf(entryId)) && request.resource.data.keys().hasOnly(['photos'])
                        && request.resource.data.photos.size() <= 3);   // 앱·서버와 같은 최대 3장 (2026-10-27)
      allow update: if isAdmin()
                    || ((isSelf(entryId) || (signedIn() && request.auth.uid in resource.data.get('owners', [])))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos'])
                        && request.resource.data.photos.size() <= 3);
      allow delete: if isAdmin() || isSelf(entryId)
                    || (signedIn() && request.auth.uid in resource.data.get('owners', []));
    }

    // 푸시 토큰 — 본인 것만, 관리자는 전체(알림 설정 확인용)
    match /pushTokens/{entryId} {
      allow read: if isAdmin() || isSelf(entryId);
      // 관리자 알림 목록('admin')은 서버만 씀 (10-29 기기에 묶기 — 앱은 adminDevice pushOn/pushOff, 옛 목록은 서버가 비움)
      allow delete: if entryId != 'admin' && (isAdmin() || isSelf(entryId));
      // 쓰기: 관리자, 또는 로그인한 회원·승인대기 본인만 + 앱이 쓰는 필드만·토큰 10개까지 (2026-10-27)
      // '이번만 허용' 관리자(ao)는 남의 알림 문서도 못 씀
      allow create, update: if entryId != 'admin'
                    && ((isAdmin() && request.auth.token.get('ao', 0) == 0)
                    || (isSelf(entryId) && (request.auth.token.m == 1 || request.auth.token.p == 1)
                        && request.resource.data.keys().hasOnly(['tokens', 'nickname', 'updatedAt'])
                        && request.resource.data.get('tokens', []).size() <= 10));
    }

    // 관리자 전용: 회원별 실명·번호·알게 된 경로(관리자 키로 암호화된 값) — 관리자만
    match /adminOnly/{entryId} {
      allow read, write: if isAdmin();
    }

    // 관리자 개인키(관리자 비밀번호로 감싼 값) — 관리자만
    match /adminKey/{docId} {
      allow read: if isAdmin();
      allow write: if isFullAdmin();
    }

    // 대화방(두 사람당 1개) — 대화 당사자(+각자의 주선자)만 읽기, 관리자는 신고된 방만.
    // 보내기·지우기·신고는 서버 함수(chatAction)만
    match /chats/{pair} {
      allow read: if signedIn() && (request.auth.uid in resource.data.viewers
                                    || (isAdmin() && resource.data.reportedAt != null));
      allow write: if false;
    }

    // 회원↔관리자 메시지 (B-2, 2026-10-29): 본인·담당 주선자(viewers)와 관리자만 읽기, 쓰기는 서버(msgAction 등)만.
    // 전엔 app/state.messages 라 승인 회원 누구나 남의 Q&A·손님 문의를 읽을 수 있었음
    match /memberMsgs/{eid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.viewers);
      allow write: if false;
    }

    // 포털(benny3s.github.io 메인) 목록 — 누구나 읽기, 관리자만 쓰기 (2026-10-08)
    // 포털이 adminLogin 토큰으로 숨김/공개·문구를 저장. 숨김은 단순 숨김(읽기는 공개)
    match /portal/config {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 50000;
    }

    // 레이더(benny3s.github.io/radar) 열쇠 (2026-10-26) — 자료는 GitHub 에 암호화, 이 열쇠로만 풂
    // pub: 공개 키 — 누구나 읽기(PC 의 merge.py 가 암호화에 씀). key: 개인 키 — 관리자만 읽기.
    // 둘 다 관리자가 처음 한 번만 만들 수 있고 고치거나 지울 수 없음 (실수로 열쇠가 바뀌는 것 막기)
    match /radar/{doc} {
      allow read: if doc == 'pub' || (doc == 'key' && isAdmin());
      allow create: if isAdmin() && doc in ['pub', 'key']
        && request.resource.data.keys().hasOnly(['jwk', 'updatedAt'])
        && request.resource.data.jwk is string
        && request.resource.data.jwk.size() < 10000;
      allow update, delete: if false;
    }

    // 그 외 전부 차단 (secrets(PIN 해시)·loginGuard·rateLimit·sendContacts 등은 서버 전용)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
